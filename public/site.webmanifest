{
  "name": "Cadence",
  "short_name": "Cadence",
  "description": "Smart bike ride planner with live route weather, resupply radar, fueling guidance, and free .FIT/.GPX export.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#111111",
  "theme_color": "#111111",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "shared_title",
      "text": "shared_text",
      "url": "shared_url",
      "files": [
        {
          "name": "route_file",
          "accept": [".gpx", ".tcx", ".fit", "application/gpx+xml", "application/octet-stream", "text/xml"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/favicon.png?v=2",
      "sizes": "64x64 32x32",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png?v=2",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/app-icon.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
