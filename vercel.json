{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/p/:code",
      "destination": "/api/p?code=:code"
    },
    {
      "source": "/tools",
      "destination": "/api/tools"
    },
    {
      "source": "/tools/:slug",
      "destination": "/api/tools?slug=:slug"
    },
    {
      "source": "/((?!api/|assets/|images/|onboarding/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
