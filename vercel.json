{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/p/:code",
      "destination": "/api/p?code=:code"
    },
    {
      "source": "/tools",
      "destination": "/api/tools"
    },
    {
      "source": "/tools/:slug",
      "destination": "/api/tools?slug=:slug"
    },
    {
      "source": "/((?!api/|assets/|images/|onboarding/|\\.well-known/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
